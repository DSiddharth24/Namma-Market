# ─────────────────────────────────────────────
# Namma Market — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Twilio WhatsApp API
# Get from: https://console.twilio.com → Messaging → WhatsApp Sandbox
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
# Used for:
#   1. Conversational AI (GPT-4o-mini) — all chat responses
#   2. APMC price fallback (GPT-4o with web_search_preview)
#      → When Agmarknet scrape fails, GPT-4o searches
#        agmarknet.gov.in, krishimaratavahini.karnataka.gov.in, agrirate.com
#        and returns actual live prices found on the web
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Redis (optional — falls back to in-memory session storage if not set)
# For production: redis://:<password>@<host>:6379/0
REDIS_URL=redis://localhost:6379/0

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-string
FLASK_ENV=production
PORT=5000
